;;;; Shared test helper and loader
;;;; shows for each test: function, input, expected, actual, pass or fail

(load (merge-pathnames "Computa_project3.lisp" *load-truename*))

(defvar *tests-run* 0)
(defvar *tests-passed* 0)

(defun run-test (name args expected)
  (let* ((actual (handler-case (apply name args)
                   (error (e) (list :error (princ-to-string e)))))
         (passed (equal actual expected)))
    (incf *tests-run*)
    (when passed (incf *tests-passed*))
    (let ((*print-pretty* nil))
      (format t "[~a] ~(~a~) | input: ~s | expected: ~s | actual: ~s~%"
              (if passed "PASS" "FAIL") name args expected actual))
    passed))

(defun run-test-unchanged (name args)
  (let* ((before (copy-tree args))
         (problem (handler-case (progn (apply name args) nil)
                    (error (e) (princ-to-string e))))
         (passed (and (not problem) (equal args before))))
    (incf *tests-run*)
    (when passed (incf *tests-passed*))
    (let ((*print-pretty* nil))
      (format t "[~a] ~(~a~) | input: ~s | expected: inputs unchanged | actual: ~a~%"
              (if passed "PASS" "FAIL") name before
              (cond (problem problem)
                    (passed "inputs unchanged")
                    (t (format nil "inputs became ~s" args)))))
    passed))

(defmacro test-case (call expected)
  `(run-test ',(first call) (list ,@(rest call)) ',expected))

(defmacro test-unchanged (call)
  `(run-test-unchanged ',(first call) (list ,@(rest call))))

(defun test-section (title)
  (format t "~%=== ~a ===~%" title))

(defun print-test-summary ()
  (format t "~%~a of ~a tests passed~%" *tests-passed* *tests-run*)
  (if (= *tests-passed* *tests-run*)
      (format t "ALL TESTS PASSED~%")
      (format t "SOME TESTS FAILED~%")))


